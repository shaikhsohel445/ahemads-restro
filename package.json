{
  "name": "nodedr-orderrestro",
  "private": true,
  "version": "0.1.0",
  "description": "Nodedr OrderRestro — restaurant management on Cloudflare (Workers, D1, R2, Durable Objects), Saudi Arabia edition",
  "author": "Raktim Ranjit <mail@raktimranjit.com> (https://github.com/Raktim94)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raktim94/nodedr-restaurant-pos.git"
  },
  "bugs": {
    "url": "https://github.com/Raktim94/nodedr-restaurant-pos/issues"
  },
  "homepage": "https://orderrestro.nodedr.com/",
  "keywords": [
    "restaurant-management",
    "restaurant-pos",
    "point-of-sale",
    "kitchen-display-system",
    "qr-ordering",
    "cloudflare-workers",
    "cloudflare-d1",
    "saudi-arabia",
    "arabic",
    "rtl",
    "zatca",
    "vat",
    "nestjs",
    "nextjs"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:cf": "turbo run build:cf",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "i18n:check": "pnpm --filter @nodedr-restaurant/web i18n:check",
    "db:migrate:local": "pnpm --filter @nodedr-restaurant/api db:migrate:local",
    "db:seed:local": "pnpm --filter @nodedr-restaurant/api db:seed:local",
    "test:smoke": "node scripts/verify/smoke-api.mjs",
    "test:migration": "scripts/migration/test/run-local.sh",
    "deploy:staging": "pnpm --filter @nodedr-restaurant/api deploy:staging && pnpm --filter @nodedr-restaurant/web deploy:staging",
    "deploy:production": "pnpm --filter @nodedr-restaurant/api deploy:production && pnpm --filter @nodedr-restaurant/web deploy:production"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12 <23 || >=24"
  }
}
