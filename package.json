{
  "name": "ahemads-restro",
  "private": true,
  "version": "2.0.0",
  "description": "Ahemad's Restro: restaurant management software on Cloudflare, in English and Arabic",
  "author": "Wem Studios (https://wemstudios.in/)",
  "license": "AGPL-3.0-only",
  "homepage": "https://wemstudios.in/",
  "keywords": [
    "restaurant-management",
    "restaurant-pos",
    "point-of-sale",
    "kitchen-display-system",
    "qr-ordering",
    "cloudflare-workers",
    "cloudflare-d1",
    "saudi-arabia",
    "arabic",
    "rtl",
    "zatca",
    "vat",
    "nestjs",
    "nextjs"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:cf": "turbo run build:cf",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "i18n:check": "pnpm --filter @ahemads-restro/web i18n:check",
    "db:migrate:local": "pnpm --filter @ahemads-restro/api db:migrate:local",
    "db:seed:local": "pnpm --filter @ahemads-restro/api db:seed:local",
    "test:smoke": "node scripts/verify/smoke-api.mjs",
    "test:migration": "scripts/migration/test/run-local.sh",
    "deploy:staging": "pnpm --filter @ahemads-restro/api deploy:staging && pnpm --filter @ahemads-restro/web deploy:staging",
    "deploy:production": "pnpm --filter @ahemads-restro/api deploy:production && pnpm --filter @ahemads-restro/web deploy:production"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12 <23 || >=24"
  },
  "contributors": [
    "Raktim Ranjit and Nodedr Infotech Private Limited, original Nodedr OrderRestro (AGPL-3.0)"
  ]
}
